<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <!-- Disable WASM static asset compression in Debug to avoid SDK bug (duplicate key in ApplyCompressionNegotiation) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <BlazorEnableCompression>false</BlazorEnableCompression>
  </PropertyGroup>

  <!--
    Auto-clean stale compressed-asset cache so the duplicate-key SDK bug never
    fires, even if the obj folder was created before BlazorEnableCompression=false
    was set or after switching between Debug and Release builds.
  -->
  <Target Name="CleanStaleWasmCompressionCache"
          BeforeTargets="ResolveStaticWebAssetsInputs"
          Condition="'$(Configuration)' == 'Debug'">
    <RemoveDir Directories="$(IntermediateOutputPath)compressed"    ContinueOnError="true" />
    <RemoveDir Directories="$(IntermediateOutputPath)staticwebassets" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.5" />
  </ItemGroup>

</Project>
