@page "/character/{CharId:int}"
@using AionOverdose58.Shared.Models.Aion
@using AionOverdose58.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AionWorldDbContext> AionWorldDbFactory
@inject NavigationManager Navigation

<PageTitle>@(_character is null ? "Character" : _character.Name) — Aion Overdose 58</PageTitle>

<div class="min-h-screen pt-56 pb-16 px-4">
    <div class="max-w-3xl mx-auto">

        @if (_loading)
        {
            <div class="flex items-center justify-center py-24 text-aion-gold font-cinzel tracking-widest animate-pulse">
                Loading...
            </div>
        }
        else if (_character is null)
        {
            <div class="text-center py-24">
                <p class="font-cinzel text-2xl text-gray-400 uppercase tracking-widest">Character Not Found</p>
                <p class="text-gray-600 text-sm mt-3 font-raleway">This character does not exist or has been removed.</p>
                <a href="/" class="mt-6 inline-block text-aion-gold hover:text-white text-sm uppercase tracking-widest transition-colors">← Return Home</a>
            </div>
        }
        else
        {
            <!-- Header -->
            <div class="mb-8">
                <a href="/account/control-panel" class="inline-flex items-center gap-2 text-gray-500 hover:text-aion-gold text-xs uppercase tracking-widest transition-colors">
                    <span>←</span> Back to Character List
                </a>
                <h1 class="font-cinzel text-3xl md:text-4xl text-white tracking-widest uppercase mt-3">@_character.Name</h1>
                <div class="flex items-center gap-3 mt-2">
                    <div class="h-px w-12 bg-aion-gold/60"></div>
                    <span class="text-aion-gold text-sm">⚔</span>
                    <div class="h-px w-12 bg-aion-gold/60"></div>
                    <div class="flex items-center gap-1.5">
                        @if (!string.IsNullOrEmpty(_character.RaceIconPath))
                        {
                            <img src="@_character.RaceIconPath" alt="@_character.RaceName" class="w-4 h-4 object-contain" />
                        }
                        <span class="text-gray-400 text-sm font-raleway">@_character.RaceName @_character.ClassName</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                <!-- Character portrait / stat card -->
                <div class="md:col-span-1">
                    <div class="bg-gray-900/80 border border-gray-700/50 rounded-lg p-6 text-center space-y-4">
                        <div class="w-20 h-20 rounded-full bg-aion-teal/20 border border-aion-teal/40 flex items-center justify-center mx-auto overflow-hidden">
                            @if (!string.IsNullOrEmpty(_character.ClassIconPath))
                            {
                                <img src="@_character.ClassIconPath" alt="@_character.ClassName" class="w-14 h-14 object-contain" />
                            }
                            else
                            {
                                <span class="text-4xl">⚔</span>
                            }
                        </div>
                        <div>
                            <p class="font-cinzel text-white text-xl">@_character.Name</p>
                            <p class="text-gray-400 text-sm mt-1 font-raleway">@_character.ClassName</p>
                        </div>
                        <div class="text-aion-gold font-cinzel text-2xl">Lv. @_character.Level</div>
                        @if (_character.IsBanned)
                        {
                            <span class="inline-block px-3 py-1 bg-aion-red/20 border border-aion-red/40 text-aion-crimson text-xs rounded-full uppercase tracking-wider">
                                Banned
                            </span>
                        }
                        else
                        {
                            <span class="inline-block px-3 py-1 bg-green-900/20 border border-green-500/30 text-green-400 text-xs rounded-full uppercase tracking-wider">
                                Active
                            </span>
                        }
                    </div>
                </div>

                <!-- Details -->
                <div class="md:col-span-2 space-y-4">
                    <div class="bg-gray-900/80 border border-gray-700/50 rounded-lg p-6">
                        <h2 class="font-cinzel text-aion-gold text-xs uppercase tracking-widest mb-4">Character Details</h2>
                        <dl class="divide-y divide-gray-800">
                            <div class="py-3 flex gap-4">
                                <dt class="text-gray-500 text-xs uppercase tracking-widest w-36 shrink-0">Character ID</dt>
                                <dd class="text-gray-200 text-sm">#@_character.CharId</dd>
                            </div>
                            <div class="py-3 flex gap-4">
                                <dt class="text-gray-500 text-xs uppercase tracking-widest w-36 shrink-0">Race</dt>
                                <dd class="text-gray-200 text-sm flex items-center gap-2">
                                    @if (!string.IsNullOrEmpty(_character.RaceIconPath))
                                    {
                                        <img src="@_character.RaceIconPath" alt="@_character.RaceName" class="w-4 h-4 object-contain" />
                                    }
                                    @_character.RaceName
                                </dd>
                            </div>
                            <div class="py-3 flex gap-4">
                                <dt class="text-gray-500 text-xs uppercase tracking-widest w-36 shrink-0">Class</dt>
                                <dd class="text-gray-200 text-sm flex items-center gap-2">
                                    @if (!string.IsNullOrEmpty(_character.ClassIconPath))
                                    {
                                        <img src="@_character.ClassIconPath" alt="@_character.ClassName" class="w-4 h-4 object-contain" />
                                    }
                                    @_character.ClassName
                                </dd>
                            </div>
                            <div class="py-3 flex gap-4">
                                <dt class="text-gray-500 text-xs uppercase tracking-widest w-36 shrink-0">Level</dt>
                                <dd class="text-gray-200 text-sm">@_character.Level</dd>
                            </div>
                            <div class="py-3 flex gap-4">
                                <dt class="text-gray-500 text-xs uppercase tracking-widest w-36 shrink-0">Gender</dt>
                                <dd class="text-gray-200 text-sm">@(_character.IsFemale ? "Female" : "Male")</dd>
                            </div>
                            @if (_character.GuildId.HasValue && _character.GuildId != 0)
                            {
                                <div class="py-3 flex gap-4">
                                    <dt class="text-gray-500 text-xs uppercase tracking-widest w-36 shrink-0">Legion ID</dt>
                                    <dd class="text-gray-200 text-sm">#@_character.GuildId</dd>
                                </div>
                            }
                            <div class="py-3 flex gap-4">
                                <dt class="text-gray-500 text-xs uppercase tracking-widest w-36 shrink-0">Last Login</dt>
                                <dd class="text-gray-200 text-sm">@(_character.LastLoginTime?.ToString("MMM d, yyyy HH:mm") ?? "—")</dd>
                            </div>
                            <div class="py-3 flex gap-4">
                                <dt class="text-gray-500 text-xs uppercase tracking-widest w-36 shrink-0">Last Logout</dt>
                                <dd class="text-gray-200 text-sm">@(_character.LastLogoutTime?.ToString("MMM d, yyyy HH:mm") ?? "—")</dd>
                            </div>
                        </dl>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@code {
    [Parameter] public int CharId { get; set; }

    private AionCharacter? _character;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var ctx = await AionWorldDbFactory.CreateDbContextAsync();
            _character = await ctx.Characters
                .AsNoTracking()
                .FirstOrDefaultAsync(c => c.CharId == CharId);
        }
        catch
        {
            _character = null;
        }
        finally
        {
            _loading = false;
        }
    }
}
