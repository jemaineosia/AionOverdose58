@page "/account/forgot-password"
@rendermode InteractiveServer
@using AionOverdose58.Web.Services
@inject IAccountService AccountService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IAuditLogger AuditLogger
@inject IJSRuntime JSRuntime
@inject IRecaptchaService RecaptchaService

<PageTitle>Forgot Password — Aion Overdose 58</PageTitle>

<div class="min-h-screen flex items-center justify-center px-4 pt-32 pb-16">
    <div class="w-full max-w-md">
        <div class="bg-gray-900/80 border border-gray-700/50 rounded-lg p-8">
            <div class="text-center mb-8">
                <div class="text-5xl mb-4">🔑</div>
                <h1 class="font-cinzel text-2xl text-white tracking-widest uppercase mb-2">Forgot Password</h1>
                <p class="text-gray-400 text-sm font-raleway">Reset your account password</p>
            </div>

            @if (!_emailSent)
            {
                <EditForm Model="_model" OnValidSubmit="HandleForgotPassword" FormName="ForgotPasswordForm">
                    <DataAnnotationsValidator />

                    <div class="mb-5">
                        <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">Email Address</label>
                        <InputText @bind-Value="_model.Email"
                                   type="email"
                                   class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                                   placeholder="your@email.com" />
                        <ValidationMessage For="@(() => _model.Email)" class="text-red-400 text-xs mt-1" />
                        <p class="text-gray-500 text-xs mt-2">Enter your registered email address</p>
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="bg-aion-red/20 border border-aion-red/50 text-red-300 text-sm px-4 py-3 rounded mb-4">
                            @_errorMessage
                        </div>
                    }

                    <button type="submit"
                            disabled="@_isProcessing"
                            class="w-full bg-aion-crimson hover:bg-aion-red text-white font-cinzel font-bold py-3 uppercase tracking-widest transition-colors duration-300 rounded disabled:opacity-50 disabled:cursor-not-allowed mb-4">
                        @if (_isProcessing)
                        {
                            <span class="inline-flex items-center gap-2">
                                <svg class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                                </svg>
                                Sending...
                            </span>
                        }
                        else
                        {
                            <span>Send Reset Link</span>
                        }
                    </button>

                    <div class="text-center">
                        <p class="text-gray-500 text-sm mb-2">Remember your password?</p>
                        <a href="/account/login" class="text-aion-gold hover:text-white transition-colors text-sm">
                            Back to Login
                        </a>
                    </div>

                    <p class="text-center text-gray-600 text-xs mt-4">
                        Protected by reCAPTCHA —
                        <a href="https://policies.google.com/privacy" class="hover:text-gray-400" target="_blank" rel="noopener">Privacy</a> &amp;
                        <a href="https://policies.google.com/terms" class="hover:text-gray-400" target="_blank" rel="noopener">Terms</a>
                    </p>
                </EditForm>
            }
            else
            {
                <div class="text-center py-6">
                    <div class="text-5xl mb-4">📨</div>
                    <h2 class="text-aion-gold text-xl font-cinzel uppercase mb-4">Check Your Email!</h2>
                    <p class="text-gray-300 text-sm mb-6 leading-relaxed">
                        @_successMessage
                    </p>
                    
                    <div class="bg-yellow-900/20 border border-yellow-500/50 p-4 mb-6 rounded">
                        <p class="text-yellow-300 text-sm">
                            <strong>⚠️ Security Notice:</strong><br />
                            • The reset link expires in 1 hour<br />
                            • Only the most recent link will work<br />
                            • If you didn't request this, ignore it
                        </p>
                    </div>

                    <div class="bg-blue-900/20 border border-blue-500/50 p-4 mb-6 rounded">
                        <p class="text-blue-300 text-sm">
                            <strong>📌 Didn't receive the email?</strong><br />
                            • Check your spam/junk folder<br />
                            • Wait up to 5 minutes for delivery<br />
                            • Make sure the email address is correct
                        </p>
                    </div>

                    <div class="space-y-3">
                        <button @onclick="ResetForm"
                                class="w-full border-2 border-gray-600 hover:border-gray-500 text-gray-300 hover:text-white font-cinzel py-3 uppercase tracking-widest transition-colors duration-300 rounded">
                            Send Another Link
                        </button>
                        <a href="/account/login" 
                           class="block w-full text-center text-aion-gold hover:text-white transition-colors text-sm py-2">
                            Back to Login
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Additional Help -->
        <div class="mt-6 bg-gray-900/60 border border-gray-700/30 rounded-lg p-6">
            <h3 class="text-white font-cinzel uppercase text-sm mb-3">Alternative Recovery</h3>
            <p class="text-gray-400 text-xs mb-3">
                If you can't access your email or need additional help:
            </p>
            <a href="/account/pin-recovery" class="block text-aion-gold hover:text-white text-xs mb-2 transition-colors">
                → Recover Account Using PIN
            </a>
            <a href="/account/resend-confirmation" class="block text-aion-gold hover:text-white text-xs mb-2 transition-colors">
                → Resend Email Confirmation
            </a>
            <a href="#" class="block text-aion-gold hover:text-white text-xs transition-colors">
                → Contact Support (Discord)
            </a>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordModel _model = new();
    private bool _isProcessing = false;
    private bool _emailSent = false;
    private string? _errorMessage;
    private string? _successMessage;
    private string _clientIp = "Unknown";

    protected override void OnInitialized()
    {
        _clientIp = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "Unknown";
    }

    private async Task HandleForgotPassword()
    {
        if (_isProcessing) return;

        _errorMessage = null;
        _isProcessing = true;

        try
        {
            // Verify reCAPTCHA v3 token
            var recaptchaToken = await JSRuntime.InvokeAsync<string>("executeRecaptcha", "forgot_password");
            var (captchaPassed, _, captchaError) = await RecaptchaService.VerifyAsync(recaptchaToken, "forgot_password");
            if (!captchaPassed)
            {
                _errorMessage = captchaError ?? "Security check failed. Please try again.";
                AuditLogger.LogFormEvent("ForgotPassword", false, _model.Email, _clientIp, "reCAPTCHA failed");
                return;
            }

            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var (success, message) = await AccountService.ForgotPasswordAsync(_model.Email, baseUrl);

            if (success)
            {
                AuditLogger.LogFormEvent("ForgotPassword", true, _model.Email, _clientIp, "Reset email dispatched");
                _emailSent = true;
                _successMessage = message;
            }
            else
            {
                AuditLogger.LogFormEvent("ForgotPassword", false, _model.Email, _clientIp, message);
                _errorMessage = message;
            }

        }
        catch (Exception ex)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
            Console.WriteLine($"Forgot password error: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void ResetForm()
    {
        _emailSent = false;
        _model = new();
        _errorMessage = null;
        _successMessage = null;
    }

    private class ForgotPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = string.Empty;
    }
}
