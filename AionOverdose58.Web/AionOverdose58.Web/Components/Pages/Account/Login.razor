@page "/account/login"
@using AionOverdose58.Shared.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject AionOverdose58.Web.Services.IAuditLogger AuditLogger

<PageTitle>Login — Aion Overdose 58</PageTitle>

<div class="min-h-screen flex items-center justify-center px-4 pt-32 pb-16">
    <div class="w-full max-w-md">
        <!-- Card -->
        <div class="bg-gray-900/80 border border-gray-700/50 rounded-lg p-8">
            <div class="text-center mb-8">
                <div class="text-3xl mb-2">☠</div>
                <h1 class="font-cinzel text-2xl text-white tracking-widest uppercase">Login</h1>
                <p class="text-gray-400 text-sm mt-2 font-raleway">Enter the realm, Daeva</p>
            </div>

            <EditForm Model="Input!" OnValidSubmit="HandleLogin" FormName="LoginForm" method="post">
                <DataAnnotationsValidator />

                <div class="mb-5">
                    <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">Username or Email</label>
                    <InputText @bind-Value="Input.UsernameOrEmail"
                               class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                               placeholder="username or email" />
                    <ValidationMessage For="@(() => Input.UsernameOrEmail)" class="text-red-400 text-xs mt-1" />
                </div>

                <div class="mb-4">
                    <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">Password</label>
                    <InputText @bind-Value="Input.Password"
                               type="password"
                               class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                               placeholder="••••••••" />
                    <ValidationMessage For="@(() => Input.Password)" class="text-red-400 text-xs mt-1" />
                </div>

                <div class="mb-6 flex items-center justify-between">
                    <label class="flex items-center gap-2 text-sm text-gray-400 cursor-pointer">
                        <InputCheckbox @bind-Value="Input.RememberMe" 
                                     class="w-4 h-4 bg-gray-800 border-gray-600 rounded focus:ring-aion-gold" />
                        <span>Remember me</span>
                    </label>
                    <div class="flex flex-col items-end gap-1">
                        <a href="/account/forgot-password" class="text-xs text-aion-gold hover:text-white transition-colors">Forgot Password?</a>
                        <a href="/account/pin-recovery" class="text-xs text-gray-500 hover:text-aion-gold transition-colors">Recover with PIN</a>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="bg-aion-red/20 border border-aion-red/50 text-red-300 text-sm px-4 py-3 rounded mb-4">
                        @_errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="bg-green-900/20 border border-green-500/50 text-green-300 text-sm px-4 py-3 rounded mb-4">
                        @_successMessage
                    </div>
                }

                <button type="submit"
                        class="w-full bg-aion-crimson hover:bg-aion-red text-white font-cinzel font-bold py-3 uppercase tracking-widest transition-colors duration-300 rounded">
                    Login
                </button>
            </EditForm>

            <div class="mt-6 text-center">
                <p class="text-gray-500 text-sm">
                    Don't have an account?
                    <a href="/account/register" class="text-aion-gold hover:text-white transition-colors">Register</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private LoginModel? Input { get; set; }

    private string? _errorMessage;
    private string? _successMessage;

    protected override void OnInitialized()
    {
        Input ??= new();

        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["registered"] == "1" && !string.IsNullOrEmpty(query["msg"]))
        {
            _successMessage = query["msg"];
        }
        else if (query["reason"] == "password-changed")
        {
            _successMessage = "Your password has been changed. Please log in again.";
        }
    }

    private async Task HandleLogin()
    {
        _errorMessage = null;
        _successMessage = null;

        // Try sign-in by username directly
        var result = await SignInManager.PasswordSignInAsync(
            Input!.UsernameOrEmail,
            Input.Password,
            Input.RememberMe,
            lockoutOnFailure: true);

        // If that failed and it looks like a username (not email), look up the email and retry
        if (!result.Succeeded && !Input.UsernameOrEmail.Contains('@'))
        {
            var user = await SignInManager.UserManager.FindByNameAsync(Input.UsernameOrEmail);
            if (user?.Email != null)
            {
                result = await SignInManager.PasswordSignInAsync(
                    user.Email,
                    Input.Password,
                    Input.RememberMe,
                    lockoutOnFailure: true);
            }
        }

        var ip = HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "Unknown";

        if (result.Succeeded)
        {
            AuditLogger.LogFormEvent("Login", true, Input!.UsernameOrEmail, ip, "Logged in");
            HttpContext?.Response.Redirect("/");
            return;
        }

        if (result.IsLockedOut)
        {
            _errorMessage = "Account locked due to multiple failed login attempts. Please try again later.";
            AuditLogger.LogFormEvent("Login", false, Input!.UsernameOrEmail, ip, "Account locked out");
            return;
        }

        if (result.IsNotAllowed)
        {
            _errorMessage = "Please confirm your email address before logging in. Check your inbox for the confirmation link.";
            AuditLogger.LogFormEvent("Login", false, Input!.UsernameOrEmail, ip, "Email not confirmed");
            return;
        }

        AuditLogger.LogFormEvent("Login", false, Input!.UsernameOrEmail, ip, "Invalid credentials");
        _errorMessage = "Invalid username/email or password.";
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Username or email is required")]
        public string UsernameOrEmail { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; } = false;
    }
}
