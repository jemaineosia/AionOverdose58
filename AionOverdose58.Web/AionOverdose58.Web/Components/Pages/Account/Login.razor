@page "/account/login"
@rendermode InteractiveAuto

<PageTitle>Login — Aion Overdose 58</PageTitle>

<div class="min-h-screen bg-aion-dark flex items-center justify-center px-4 pt-20">
    <div class="w-full max-w-md">
        <!-- Card -->
        <div class="bg-gray-900/80 border border-gray-700/50 rounded-lg p-8">
            <div class="text-center mb-8">
                <div class="text-3xl mb-2">☠</div>
                <h1 class="font-cinzel text-2xl text-white tracking-widest uppercase">Login</h1>
                <p class="text-gray-400 text-sm mt-2 font-raleway">Enter the realm, Daeva</p>
            </div>

            <EditForm Model="_loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
                <DataAnnotationsValidator />

                <div class="mb-5">
                    <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">Email</label>
                    <InputText @bind-Value="_loginModel.Email"
                               type="email"
                               class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                               placeholder="your@email.com" />
                    <ValidationMessage For="@(() => _loginModel.Email)" class="text-red-400 text-xs mt-1" />
                </div>

                <div class="mb-6">
                    <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">Password</label>
                    <InputText @bind-Value="_loginModel.Password"
                               type="password"
                               class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                               placeholder="••••••••" />
                    <ValidationMessage For="@(() => _loginModel.Password)" class="text-red-400 text-xs mt-1" />
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="bg-aion-red/20 border border-aion-red/50 text-red-300 text-sm px-4 py-3 rounded mb-4">
                        @_errorMessage
                    </div>
                }

                <button type="submit"
                        class="w-full bg-aion-crimson hover:bg-aion-red text-white font-cinzel font-bold py-3 uppercase tracking-widest transition-colors duration-300 rounded">
                    Login
                </button>
            </EditForm>

            <div class="mt-6 text-center">
                <p class="text-gray-500 text-sm">
                    Don't have an account?
                    <a href="/account/register" class="text-aion-gold hover:text-white transition-colors">Register</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel _loginModel = new();
    private string? _errorMessage;

    private void HandleLogin()
    {
        // TODO: Implement authentication logic
        _errorMessage = "Authentication not yet implemented. Coming soon!";
    }

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;
    }
}
