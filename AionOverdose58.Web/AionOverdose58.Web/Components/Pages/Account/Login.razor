@page "/account/login"
@rendermode InteractiveAuto
@using AionOverdose58.Shared.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation

<PageTitle>Login — Aion Overdose 58</PageTitle>

<div class="min-h-screen flex items-center justify-center px-4 pt-32 pb-16">
    <div class="w-full max-w-md">
        <!-- Card -->
        <div class="bg-gray-900/80 border border-gray-700/50 rounded-lg p-8">
            <div class="text-center mb-8">
                <div class="text-3xl mb-2">☠</div>
                <h1 class="font-cinzel text-2xl text-white tracking-widest uppercase">Login</h1>
                <p class="text-gray-400 text-sm mt-2 font-raleway">Enter the realm, Daeva</p>
            </div>

            <EditForm Model="_loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
                <DataAnnotationsValidator />

                <div class="mb-5">
                    <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">Username or Email</label>
                    <InputText @bind-Value="_loginModel.UsernameOrEmail"
                               class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                               placeholder="username or email" />
                    <ValidationMessage For="@(() => _loginModel.UsernameOrEmail)" class="text-red-400 text-xs mt-1" />
                </div>

                <div class="mb-4">
                    <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">Password</label>
                    <InputText @bind-Value="_loginModel.Password"
                               type="password"
                               class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                               placeholder="••••••••" />
                    <ValidationMessage For="@(() => _loginModel.Password)" class="text-red-400 text-xs mt-1" />
                </div>

                <div class="mb-6 flex items-center justify-between">
                    <label class="flex items-center gap-2 text-sm text-gray-400 cursor-pointer">
                        <InputCheckbox @bind-Value="_loginModel.RememberMe" 
                                     class="w-4 h-4 bg-gray-800 border-gray-600 rounded focus:ring-aion-gold" />
                        <span>Remember me</span>
                    </label>
                    <div class="flex flex-col items-end gap-1">
                        <a href="/account/forgot-password" class="text-xs text-aion-gold hover:text-white transition-colors">Forgot Password?</a>
                        <a href="/account/pin-recovery" class="text-xs text-gray-500 hover:text-aion-gold transition-colors">Recover with PIN</a>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="bg-aion-red/20 border border-aion-red/50 text-red-300 text-sm px-4 py-3 rounded mb-4">
                        @_errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="bg-green-900/20 border border-green-500/50 text-green-300 text-sm px-4 py-3 rounded mb-4">
                        @_successMessage
                    </div>
                }

                <button type="submit"
                        disabled="@_isProcessing"
                        class="w-full bg-aion-crimson hover:bg-aion-red text-white font-cinzel font-bold py-3 uppercase tracking-widest transition-colors duration-300 rounded disabled:opacity-50 disabled:cursor-not-allowed">
                    @(_isProcessing ? "Logging in..." : "Login")
                </button>
            </EditForm>

            <div class="mt-6 text-center">
                <p class="text-gray-500 text-sm">
                    Don't have an account?
                    <a href="/account/register" class="text-aion-gold hover:text-white transition-colors">Register</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel _loginModel = new();
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isProcessing = false;

    private async Task HandleLogin()
    {
        if (_isProcessing) return;

        _errorMessage = null;
        _successMessage = null;
        _isProcessing = true;

        try
        {
            // Try to find user by username or email
            var result = await SignInManager.PasswordSignInAsync(
                _loginModel.UsernameOrEmail,
                _loginModel.Password,
                _loginModel.RememberMe,
                lockoutOnFailure: true);

            if (result.Succeeded)
            {
                _successMessage = "Login successful! Redirecting...";
                await Task.Delay(1000);
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }

            if (result.IsLockedOut)
            {
                _errorMessage = "Account locked due to multiple failed login attempts. Please try again later.";
                return;
            }

            if (result.RequiresTwoFactor)
            {
                _errorMessage = "Two-factor authentication required.";
                return;
            }

            if (result.IsNotAllowed)
            {
                _errorMessage = "Please confirm your email address before logging in. Check your inbox for the confirmation link.";
                return;
            }

            // If username login failed, try email
            if (!result.Succeeded && !_loginModel.UsernameOrEmail.Contains("@"))
            {
                // Try finding user by username and get their email
                var userManager = SignInManager.UserManager;
                var user = await userManager.FindByNameAsync(_loginModel.UsernameOrEmail);

                if (user != null && user.Email != null)
                {
                    result = await SignInManager.PasswordSignInAsync(
                        user.Email,
                        _loginModel.Password,
                        _loginModel.RememberMe,
                        lockoutOnFailure: true);

                    if (result.Succeeded)
                    {
                        _successMessage = "Login successful! Redirecting...";
                        await Task.Delay(1000);
                        Navigation.NavigateTo("/", forceLoad: true);
                        return;
                    }
                }
            }

            _errorMessage = "Invalid username/email or password.";
        }
        catch (Exception ex)
        {
            _errorMessage = "An error occurred during login. Please try again.";
            Console.WriteLine($"Login error: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Username or email is required")]
        public string UsernameOrEmail { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; } = false;
    }
}
