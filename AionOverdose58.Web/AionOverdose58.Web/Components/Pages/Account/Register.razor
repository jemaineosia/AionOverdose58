@page "/account/register"
@rendermode InteractiveServer
@using AionOverdose58.Web.Services
@inject IAccountService AccountService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IAuditLogger AuditLogger
@inject IRecaptchaService RecaptchaService
@inject IJSRuntime JSRuntime

<PageTitle>Register — Aion Overdose 58</PageTitle>

<div class="min-h-screen flex items-center justify-center px-4 pt-32 pb-16">
    <div class="w-full max-w-md">
        <div class="bg-gray-900/80 border border-gray-700/50 rounded-lg p-8">
            <div class="text-center mb-8">
                <div class="text-3xl mb-2">☠</div>
                <h1 class="font-cinzel text-2xl text-white tracking-widest uppercase">Register</h1>
                <p class="text-gray-400 text-sm mt-2 font-raleway">Join the eternal conflict</p>
            </div>

            <EditForm Model="_registerModel" OnValidSubmit="HandleRegister" FormName="RegisterForm">
                <DataAnnotationsValidator />

                <div class="mb-4">
                    <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">Email</label>
                    <InputText @bind-Value="_registerModel.Email"
                               type="email"
                               class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                               placeholder="your@email.com" />
                    <ValidationMessage For="@(() => _registerModel.Email)" class="text-red-400 text-xs mt-1" />
                </div>

                <div class="mb-4">
                    <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">Password</label>
                    <InputText @bind-Value="_registerModel.Password"
                               type="password"
                               class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                               placeholder="••••••••" />
                    <ValidationMessage For="@(() => _registerModel.Password)" class="text-red-400 text-xs mt-1" />
                </div>

                <div class="mb-6">
                    <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">Confirm Password</label>
                    <InputText @bind-Value="_registerModel.ConfirmPassword"
                               type="password"
                               class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                               placeholder="••••••••" />
                    <ValidationMessage For="@(() => _registerModel.ConfirmPassword)" class="text-red-400 text-xs mt-1" />
                </div>

                <div class="mb-4">
                    <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">PIN Code (4-6 digits)</label>
                    <InputText @bind-Value="_registerModel.PinCode"
                               type="password"
                               maxlength="6"
                               class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                               placeholder="Enter 4-6 digit PIN" />
                    <ValidationMessage For="@(() => _registerModel.PinCode)" class="text-red-400 text-xs mt-1" />
                    <p class="text-gray-500 text-xs mt-1">Used for account security and recovery</p>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="bg-aion-red/20 border border-aion-red/50 text-red-300 text-sm px-4 py-3 rounded mb-4">
                        @_errorMessage
                    </div>
                }

                <button type="submit"
                        disabled="@_isProcessing"
                        class="w-full bg-aion-crimson hover:bg-aion-red text-white font-cinzel font-bold py-3 uppercase tracking-widest transition-colors duration-300 rounded disabled:opacity-50 disabled:cursor-not-allowed">
                    @if (_isProcessing)
                    {
                        <span class="inline-flex items-center gap-2">
                            <svg class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                            </svg>
                            Processing...
                        </span>
                    }
                    else
                    {
                        <span>Register</span>
                    }
                </button>

                <p class="text-center text-gray-600 text-xs mt-3">
                    Protected by reCAPTCHA —
                    <a href="https://policies.google.com/privacy" class="hover:text-gray-400" target="_blank" rel="noopener">Privacy</a> &amp;
                    <a href="https://policies.google.com/terms" class="hover:text-gray-400" target="_blank" rel="noopener">Terms</a>
                </p>
            </EditForm>

            <div class="mt-6 text-center">
                <p class="text-gray-500 text-sm">
                    Already have an account?
                    <a href="/account/login" class="text-aion-gold hover:text-white transition-colors">Login</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterModel _registerModel = new();
    private string? _errorMessage;
    private bool _isProcessing = false;
    private string _clientIp = "Unknown";

    protected override void OnInitialized()
    {
        _clientIp = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "Unknown";
    }

    private async Task HandleRegister()
    {
        if (_isProcessing) return;

        _errorMessage = null;
        _isProcessing = true;

        try
        {
            // Execute reCAPTCHA v3 and verify server-side
            string recaptchaToken;
            try
            {
                recaptchaToken = await JSRuntime.InvokeAsync<string>("executeRecaptcha", "register");
            }
            catch
            {
                _errorMessage = "Security check failed to load. Please refresh the page and try again.";
                return;
            }

            var (captchaPassed, _, captchaError) = await RecaptchaService.VerifyAsync(recaptchaToken, "register");
            if (!captchaPassed)
            {
                _errorMessage = captchaError ?? "Security check failed. Please try again.";
                AuditLogger.LogFormEvent("Register", false, _registerModel.Email, _clientIp, "reCAPTCHA failed");
                return;
            }

            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var (success, message) = await AccountService.RegisterAccountAsync(
                _registerModel.Email,
                _registerModel.Password,
                _registerModel.PinCode,
                baseUrl
            );

            if (success)
            {
                AuditLogger.LogFormEvent("Register", true, _registerModel.Email, _clientIp, "New account registered");
                Navigation.NavigateTo($"/account/login?registered=1&msg={Uri.EscapeDataString(message)}");
                return;
            }
            else
            {
                AuditLogger.LogFormEvent("Register", false, _registerModel.Email, _clientIp, message);
                _errorMessage = message;
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Invalid email address")]
        [System.ComponentModel.DataAnnotations.StringLength(256, ErrorMessage = "Email cannot exceed 256 characters")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        [System.ComponentModel.DataAnnotations.StringLength(16, MinimumLength = 6, 
            ErrorMessage = "Password must be between 6 and 16 characters")]
        [System.ComponentModel.DataAnnotations.RegularExpression(@"^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d@$!%*#?&]{6,16}$", 
            ErrorMessage = "Password must contain at least one letter and one number")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your password")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "PIN code is required")]
        [System.ComponentModel.DataAnnotations.RegularExpression(@"^\d{4,6}$", ErrorMessage = "PIN must be 4-6 digits only")]
        [System.ComponentModel.DataAnnotations.StringLength(6, MinimumLength = 4, 
            ErrorMessage = "PIN must be between 4 and 6 digits")]
        public string PinCode { get; set; } = string.Empty;
    }
}
