@page "/account/resend-confirmation"
@rendermode InteractiveServer
@using AionOverdose58.Web.Services
@inject IAccountService AccountService
@inject NavigationManager Navigation

<PageTitle>Resend Confirmation Email — Aion Overdose 58</PageTitle>

<div class="min-h-screen flex items-center justify-center px-4 pt-32 pb-16">
    <div class="w-full max-w-md">
        <div class="bg-gray-900/80 border border-gray-700/50 rounded-lg p-8">
            <div class="text-center mb-8">
                <div class="text-5xl mb-4">📧</div>
                <h1 class="font-cinzel text-2xl text-white tracking-widest uppercase mb-2">Resend Confirmation</h1>
                <p class="text-gray-400 text-sm font-raleway">Didn't receive the confirmation email?</p>
            </div>

            @if (!_emailSent)
            {
                <EditForm Model="_model" OnValidSubmit="HandleResend" FormName="ResendForm">
                    <DataAnnotationsValidator />

                    <div class="mb-6">
                        <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">Email Address</label>
                        <InputText @bind-Value="_model.Email"
                                   type="email"
                                   class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                                   placeholder="your@email.com" />
                        <ValidationMessage For="@(() => _model.Email)" class="text-red-400 text-xs mt-1" />
                        <p class="text-gray-500 text-xs mt-2">Enter the email address you used to register</p>
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="bg-aion-red/20 border border-aion-red/50 text-red-300 text-sm px-4 py-3 rounded mb-4">
                            @_errorMessage
                        </div>
                    }

                    <button type="submit"
                            disabled="@_isProcessing"
                            class="w-full bg-aion-gold hover:bg-aion-gold/80 text-aion-dark font-cinzel font-bold py-3 uppercase tracking-widest transition-colors duration-300 rounded disabled:opacity-50 disabled:cursor-not-allowed mb-4">
                        @(_isProcessing ? "Sending..." : "Resend Confirmation Email")
                    </button>

                    <div class="text-center">
                        <p class="text-gray-500 text-sm mb-2">Remember your login?</p>
                        <a href="/account/login" class="text-aion-gold hover:text-white transition-colors text-sm">
                            Back to Login
                        </a>
                    </div>
                </EditForm>
            }
            else
            {
                <div class="text-center py-6">
                    <div class="text-5xl mb-4">✅</div>
                    <h2 class="text-aion-gold text-xl font-cinzel uppercase mb-4">Email Sent!</h2>
                    <p class="text-gray-300 text-sm mb-6 leading-relaxed">
                        @_successMessage
                    </p>
                    
                    <div class="bg-blue-900/20 border border-blue-500/50 p-4 mb-6 rounded">
                        <p class="text-blue-300 text-sm">
                            <strong>📌 Important:</strong><br />
                            • Check your spam/junk folder<br />
                            • Add noreply@aionoverdose58.com to contacts<br />
                            • Wait a few minutes for delivery
                        </p>
                    </div>

                    <div class="space-y-3">
                        <button @onclick="ResetForm"
                                class="w-full border-2 border-gray-600 hover:border-gray-500 text-gray-300 hover:text-white font-cinzel py-3 uppercase tracking-widest transition-colors duration-300 rounded">
                            Resend Again
                        </button>
                        <a href="/account/login" 
                           class="block w-full text-center text-aion-gold hover:text-white transition-colors text-sm py-2">
                            Back to Login
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Help Section -->
        <div class="mt-6 bg-gray-900/60 border border-gray-700/30 rounded-lg p-6">
            <h3 class="text-white font-cinzel uppercase text-sm mb-3">Still Having Issues?</h3>
            <ul class="text-gray-400 text-xs space-y-2">
                <li class="flex items-start gap-2">
                    <span class="text-aion-gold">•</span>
                    <span>Email may take up to 5 minutes to arrive</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="text-aion-gold">•</span>
                    <span>Make sure you're checking the correct email account</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="text-aion-gold">•</span>
                    <span>Contact support if you don't receive it within 10 minutes</span>
                </li>
            </ul>
        </div>
    </div>
</div>

@code {
    private ResendModel _model = new();
    private bool _isProcessing = false;
    private bool _emailSent = false;
    private string? _errorMessage;
    private string? _successMessage;

    private async Task HandleResend()
    {
        if (_isProcessing) return;

        _errorMessage = null;
        _isProcessing = true;

        try
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var (success, message) = await AccountService.ResendConfirmationEmailAsync(_model.Email, baseUrl);

            if (success)
            {
                _emailSent = true;
                _successMessage = message;
            }
            else
            {
                _errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
            Console.WriteLine($"Resend confirmation error: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void ResetForm()
    {
        _emailSent = false;
        _model = new();
        _errorMessage = null;
        _successMessage = null;
    }

    private class ResendModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = string.Empty;
    }
}
