@page "/account/reset-password"
@rendermode InteractiveAuto
@using AionOverdose58.Web.Services
@using Microsoft.AspNetCore.Http
@inject IAccountService AccountService
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Reset Password — Aion Overdose 58</PageTitle>

<div class="min-h-screen flex items-center justify-center px-4 pt-32 pb-16">
    <div class="w-full max-w-md">
        <div class="bg-gray-900/80 border border-gray-700/50 rounded-lg p-8">
            @if (_isProcessing && !_passwordReset)
            {
                <div class="text-center py-8">
                    <div class="text-5xl mb-4">⏳</div>
                    <h1 class="font-cinzel text-2xl text-white tracking-widest uppercase mb-4">Processing</h1>
                    <p class="text-gray-400 text-sm font-raleway">Please wait...</p>
                    <div class="mt-6">
                        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-aion-gold mx-auto"></div>
                    </div>
                </div>
            }
            else if (_passwordReset)
            {
                <div class="text-center py-8">
                    <div class="text-5xl mb-4">✅</div>
                    <h1 class="font-cinzel text-2xl text-aion-gold tracking-widest uppercase mb-4">Password Reset!</h1>
                    <p class="text-gray-300 text-sm font-raleway mb-6 leading-relaxed">
                        Your password has been reset successfully. You can now log in with your new password.
                    </p>

                    <div class="bg-green-900/20 border border-green-500/50 p-4 mb-6 rounded">
                        <p class="text-green-300 text-sm">
                            <strong>✓ Success!</strong><br />
                            Your password has been updated in both the web and game databases.
                        </p>
                    </div>

                    <a href="/account/login" 
                       class="block w-full bg-aion-crimson hover:bg-aion-red text-white font-cinzel font-bold py-3 uppercase tracking-widest transition-colors duration-300 rounded text-center">
                        Login to Your Account
                    </a>
                </div>
            }
            else if (string.IsNullOrEmpty(_email) || string.IsNullOrEmpty(_code))
            {
                <div class="text-center py-8">
                    <div class="text-5xl mb-4">❌</div>
                    <h1 class="font-cinzel text-2xl text-red-400 tracking-widest uppercase mb-4">Invalid Link</h1>
                    <p class="text-gray-300 text-sm mb-6">
                        This password reset link is invalid or incomplete. Please request a new one.
                    </p>
                    
                    <a href="/account/forgot-password" 
                       class="block w-full bg-aion-gold hover:bg-aion-gold/80 text-aion-dark font-cinzel font-bold py-3 uppercase tracking-widest transition-colors duration-300 rounded text-center">
                        Request New Reset Link
                    </a>
                </div>
            }
            else
            {
                <div class="text-center mb-8">
                    <div class="text-5xl mb-4">🔐</div>
                    <h1 class="font-cinzel text-2xl text-white tracking-widest uppercase mb-2">Reset Password</h1>
                    <p class="text-gray-400 text-sm font-raleway">Enter your new password</p>
                </div>

                <EditForm Model="_model" OnValidSubmit="HandleResetPassword" FormName="ResetPasswordForm">
                    <DataAnnotationsValidator />

                    <div class="mb-4">
                        <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">New Password</label>
                        <InputText @bind-Value="_model.Password"
                                   type="password"
                                   class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                                   placeholder="••••••••" />
                        <ValidationMessage For="@(() => _model.Password)" class="text-red-400 text-xs mt-1" />
                        <p class="text-gray-500 text-xs mt-1">6-16 characters, must include letter and number</p>
                    </div>

                    <div class="mb-6">
                        <label class="block text-gray-400 text-xs uppercase tracking-widest mb-2">Confirm Password</label>
                        <InputText @bind-Value="_model.ConfirmPassword"
                                   type="password"
                                   class="w-full bg-gray-800/80 border border-gray-600 text-white px-4 py-3 rounded text-sm focus:outline-none focus:border-aion-gold/50 transition-colors placeholder-gray-600"
                                   placeholder="••••••••" />
                        <ValidationMessage For="@(() => _model.ConfirmPassword)" class="text-red-400 text-xs mt-1" />
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="bg-aion-red/20 border border-aion-red/50 text-red-300 text-sm px-4 py-3 rounded mb-4">
                            @_errorMessage
                        </div>
                    }

                    <button type="submit"
                            disabled="@_isProcessing"
                            class="w-full bg-aion-crimson hover:bg-aion-red text-white font-cinzel font-bold py-3 uppercase tracking-widest transition-colors duration-300 rounded disabled:opacity-50 disabled:cursor-not-allowed mb-4">
                        @(_isProcessing ? "Resetting..." : "Reset Password")
                    </button>

                    <div class="text-center">
                        <a href="/account/login" class="text-gray-500 hover:text-white transition-colors text-sm">
                            Cancel and return to login
                        </a>
                    </div>
                </EditForm>
            }
        </div>

        <!-- Security Tips -->
        @if (!_passwordReset && !string.IsNullOrEmpty(_email))
        {
            <div class="mt-6 bg-gray-900/60 border border-gray-700/30 rounded-lg p-6">
                <h3 class="text-white font-cinzel uppercase text-sm mb-3">Password Tips</h3>
                <ul class="text-gray-400 text-xs space-y-2">
                    <li class="flex items-start gap-2">
                        <span class="text-aion-gold">•</span>
                        <span>Use a unique password you don't use elsewhere</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-aion-gold">•</span>
                        <span>Include both letters and numbers</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-aion-gold">•</span>
                        <span>Avoid common words or personal information</span>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Code { get; set; }

    private string? _email;
    private string? _code;
    private ResetPasswordModel _model = new();
    private bool _isProcessing = false;
    private bool _passwordReset = false;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        _email = Email;
        _code = Code;
    }

    private async Task HandleResetPassword()
    {
        if (_isProcessing) return;

        _errorMessage = null;
        _isProcessing = true;

        try
        {
            if (string.IsNullOrEmpty(_email) || string.IsNullOrEmpty(_code))
            {
                _errorMessage = "Invalid reset link.";
                return;
            }

            // Get IP address
            var ipAddress = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "Unknown";

            var (success, message) = await AccountService.ResetPasswordAsync(_email, _code, _model.Password, ipAddress);

            if (success)
            {
                _passwordReset = true;
            }
            else
            {
                _errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
            Console.WriteLine($"Reset password error: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private class ResetPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        [System.ComponentModel.DataAnnotations.StringLength(16, MinimumLength = 6, 
            ErrorMessage = "Password must be between 6 and 16 characters")]
        [System.ComponentModel.DataAnnotations.RegularExpression(@"^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d@$!%*#?&]{6,16}$", 
            ErrorMessage = "Password must contain at least one letter and one number")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your password")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
