@page "/ranking"
@using AionOverdose58.Shared.Models
@using AionOverdose58.Web.Services
@inject IRankingService RankingService

<PageTitle>Player Rankings — Aion Overdose 58</PageTitle>

<div class="min-h-screen bg-aion-dark pt-40 pb-16 px-4">
    <div class="max-w-4xl mx-auto">
        <!-- Page header -->
        <div class="text-center mb-12">
            <h1 class="font-cinzel text-4xl md:text-5xl text-white tracking-widest uppercase mb-3">
                Player Rankings
            </h1>
            <div class="flex items-center justify-center gap-3">
                <div class="h-px w-20 bg-aion-gold/60"></div>
                <span class="text-aion-gold text-lg">☠</span>
                <div class="h-px w-20 bg-aion-gold/60"></div>
            </div>
        </div>

        @if (_rankings == null)
        {
            <div class="text-center text-gray-400 py-16">Loading rankings...</div>
        }
        else
        {
            <div class="overflow-hidden rounded-lg border border-gray-700/50">
                <table class="w-full">
                    <thead>
                        <tr class="bg-gray-900/90 border-b border-gray-700/50">
                            <th class="font-cinzel text-aion-gold text-xs uppercase tracking-widest px-6 py-4 text-left">Rank</th>
                            <th class="font-cinzel text-aion-gold text-xs uppercase tracking-widest px-6 py-4 text-left">Player</th>
                            <th class="font-cinzel text-aion-gold text-xs uppercase tracking-widest px-6 py-4 text-left hidden md:table-cell">Class</th>
                            <th class="font-cinzel text-aion-gold text-xs uppercase tracking-widest px-6 py-4 text-left hidden sm:table-cell">Level</th>
                            <th class="font-cinzel text-aion-gold text-xs uppercase tracking-widest px-6 py-4 text-right">Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (player, idx) in _rankings.Select((p, i) => (p, i)))
                        {
                            <tr class="border-b border-gray-800/50 @(idx % 2 == 0 ? "bg-gray-900/40" : "bg-gray-900/20") hover:bg-aion-red/10 transition-colors">
                                <td class="px-6 py-4">
                                    @if (player.Rank == 1)
                                    {
                                        <span class="font-cinzel font-bold text-lg" style="color: #FFD700;">🥇 1</span>
                                    }
                                    else if (player.Rank == 2)
                                    {
                                        <span class="font-cinzel font-bold text-lg" style="color: #C0C0C0;">🥈 2</span>
                                    }
                                    else if (player.Rank == 3)
                                    {
                                        <span class="font-cinzel font-bold text-lg" style="color: #CD7F32;">🥉 3</span>
                                    }
                                    else
                                    {
                                        <span class="font-cinzel text-gray-400">#@player.Rank</span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <span class="font-raleway text-white font-semibold">@player.PlayerName</span>
                                </td>
                                <td class="px-6 py-4 hidden md:table-cell">
                                    <span class="text-gray-300 text-sm">@player.Class</span>
                                </td>
                                <td class="px-6 py-4 hidden sm:table-cell">
                                    <span class="text-gray-300 text-sm">@player.Level</span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <span class="text-aion-gold font-semibold">@player.Score.ToString("N0")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<PlayerRanking>? _rankings;

    protected override async Task OnInitializedAsync()
    {
        _rankings = await RankingService.GetRankingsAsync();
    }
}
