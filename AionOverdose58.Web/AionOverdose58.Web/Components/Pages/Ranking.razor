@page "/ranking"
@using AionOverdose58.Shared.Models
@using AionOverdose58.Web.Services
@inject IRankingService RankingService

<PageTitle>Player Rankings — Aion Overdose 58</PageTitle>

<div class="min-h-screen pt-56 pb-16 px-4">
    <div class="max-w-4xl mx-auto">
        <!-- Page header -->
        <div class="text-center mb-12">
            <h1 class="font-cinzel text-4xl md:text-5xl text-white tracking-widest uppercase mb-3">
                Player Rankings
            </h1>
            <div class="flex items-center justify-center gap-3">
                <div class="h-px w-20 bg-aion-gold/60"></div>
                <span class="text-aion-gold text-lg">☠</span>
                <div class="h-px w-20 bg-aion-gold/60"></div>
            </div>
        </div>

        @* Rankings coming soon *@
        <div class="text-center text-gray-500 py-16 border border-gray-700/40 rounded-lg">
            <p class="font-marcellus text-xl text-gray-400 mb-2">Rankings Coming Soon</p>
            <p class="text-sm text-gray-600">Leaderboard data will be available in a future update.</p>
        </div>
    </div>
</div>

@code {
    protected override Task OnInitializedAsync() => Task.CompletedTask;
}
