@page "/server-status"

<PageTitle>Server Status — Aion Overdose 58</PageTitle>

<div class="min-h-screen pt-56 pb-16 px-4">
    <div class="max-w-4xl mx-auto">

        <!-- Page header -->
        <div class="text-center mb-12">
            <h1 class="font-cinzel text-4xl md:text-5xl text-white tracking-widest uppercase mb-3">
                Server Status
            </h1>
            <div class="flex items-center justify-center gap-3">
                <div class="h-px w-20 bg-aion-gold/60"></div>
                <span class="text-aion-gold text-lg">⚡</span>
                <div class="h-px w-20 bg-aion-gold/60"></div>
            </div>
        </div>

        <!-- Unavailable notice -->
        <div class="text-center py-20 border border-gray-700/40 rounded-lg bg-gray-900/40">
            <div class="w-16 h-16 rounded-full bg-aion-teal/10 border border-aion-teal/30 flex items-center justify-center mx-auto mb-5">
                <span class="text-2xl">⚡</span>
            </div>
            <p class="font-cinzel text-xl text-gray-300 uppercase tracking-widest mb-2">Currently Unavailable</p>
            <p class="text-sm text-gray-500 font-raleway max-w-md mx-auto">Live server status monitoring is not yet available. Check back soon for real-time server information.</p>
        </div>

    </div>
</div>
