@page "/news/{Id:int}"
@using AionOverdose58.Shared.Models
@using AionOverdose58.Web.Services
@inject IArticleReadService NewsService
@inject NavigationManager Nav

<PageTitle>@(_article?.Title ?? "Article") — Aion Overdose 58</PageTitle>

@if (_loading)
{
    <div class="min-h-screen flex items-center justify-center pt-56">
        <div class="text-center text-gray-400 py-16">Loading...</div>
    </div>
}
else if (_article == null)
{
    <div class="min-h-screen flex items-center justify-center pt-56">
        <div class="text-center py-16 px-4">
            <h1 class="font-cinzel text-3xl text-white mb-4">Article Not Found</h1>
            <a href="/news" class="text-aion-gold hover:text-white transition-colors">← Back to News</a>
        </div>
    </div>
}
else
{
    <!-- Hero Image Section -->
    @if (!string.IsNullOrEmpty(_article.ImageUrl))
    {
        <section class="relative w-full h-[60vh] md:h-[70vh] overflow-hidden">
            <!-- Background Image -->
            <div class="absolute inset-0">
                <img src="@_article.ImageUrl" alt="@_article.Title" 
                     class="w-full h-full object-cover" />
                <!-- Dark overlay for better text readability -->
                <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/80"></div>
            </div>

            <!-- Hero Content Overlay -->
            <div class="relative z-10 h-full flex flex-col justify-end pb-12 px-6 max-w-5xl mx-auto">
                <!-- Category Badge and Date -->
                <div class="flex items-center gap-3 mb-4 text-sm">
                    <span class="px-3 py-1 bg-aion-gold/90 text-aion-dark text-xs font-raleway uppercase tracking-widest font-bold rounded">
                        @_article.Category.GetDisplayName()
                    </span>
                    <span class="text-white/80 font-raleway">
                        @((_article.PostedDate ?? _article.CreatedOn).ToString("MMMM d, yyyy"))
                    </span>
                </div>

                <!-- Article Title -->
                <h1 class="font-cinzel text-3xl md:text-5xl lg:text-6xl text-white font-bold mb-6 leading-tight drop-shadow-2xl">
                    @_article.Title
                </h1>
            </div>
        </section>
    }
    else
    {
        <!-- Fallback for articles without images -->
        <section class="relative w-full pt-56 pb-12 px-6">
            <div class="max-w-5xl mx-auto">
                <div class="flex items-center gap-3 mb-4 text-sm">
                    <span class="px-3 py-1 bg-aion-gold/90 text-aion-dark text-xs font-raleway uppercase tracking-widest font-bold rounded">
                        @_article.Category.GetDisplayName()
                    </span>
                    <span class="text-white/80 font-raleway">
                        @((_article.PostedDate ?? _article.CreatedOn).ToString("MMMM d, yyyy"))
                    </span>
                </div>
                <h1 class="font-cinzel text-3xl md:text-5xl lg:text-6xl text-white font-bold mb-6 leading-tight">
                    @_article.Title
                </h1>
            </div>
        </section>
    }

    <!-- Article Content Section -->
    <section class="py-16 px-4">
        <div class="max-w-4xl mx-auto">
            <!-- Back to News Link -->
            <div class="mb-8">
                <a href="/news" class="inline-flex items-center gap-2 text-aion-gold text-sm uppercase tracking-wider font-raleway hover:text-white transition-colors group">
                    <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
                    </svg>
                    Back to News
                </a>
            </div>

            <!-- Article Content -->
            <div class="prose prose-invert prose-lg max-w-none text-gray-300 leading-relaxed">
                @((MarkupString)_article.Content)
            </div>

            <!-- Bottom Divider -->
            <div class="h-px bg-aion-gold/20 my-12"></div>

            <!-- Back to News Link (Bottom) -->
            <div class="text-center">
                <a href="/news" class="inline-flex items-center gap-2 text-aion-gold text-sm uppercase tracking-wider font-raleway hover:text-white transition-colors group">
                    <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
                    </svg>
                    Back to News
                </a>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private Article? _article;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _article = await NewsService.GetByIdAsync(Id);
        _loading = false;
    }
}
