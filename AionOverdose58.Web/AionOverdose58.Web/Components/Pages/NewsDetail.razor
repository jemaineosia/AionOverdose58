@page "/news/{Slug}"
@using AionOverdose58.Shared.Models
@using AionOverdose58.Web.Services
@inject INewsService NewsService
@inject NavigationManager Nav

<PageTitle>@(_article?.Title ?? "Article") — Aion Overdose 58</PageTitle>

<div class="min-h-screen bg-aion-dark pt-32 pb-16 px-4">
    <div class="max-w-4xl mx-auto">
        @if (_loading)
        {
            <div class="text-center text-gray-400 py-16">Loading...</div>
        }
        else if (_article == null)
        {
            <div class="text-center py-16">
                <h1 class="font-cinzel text-3xl text-white mb-4">Article Not Found</h1>
                <a href="/news" class="text-aion-gold hover:text-white transition-colors">← Back to News</a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_article.ImageUrl))
            {
                <div class="w-full aspect-video overflow-hidden rounded-lg mb-8">
                    <img src="@_article.ImageUrl" alt="@_article.Title" class="w-full h-full object-cover" />
                </div>
            }

            <div class="mb-6">
                <a href="/news" class="text-aion-gold text-sm uppercase tracking-wider hover:text-white transition-colors">
                    ← Back to News
                </a>
            </div>

            <h1 class="font-cinzel text-3xl md:text-4xl text-white font-bold mb-4 leading-tight">
                @_article.Title
            </h1>

            <div class="flex items-center gap-3 mb-8 text-sm text-gray-400">
                <span>@_article.AuthorName</span>
                <span class="text-gray-600">·</span>
                <span>@_article.PublishedAt.ToString("MMMM d, yyyy")</span>
            </div>

            <div class="h-px bg-aion-gold/20 mb-8"></div>

            <div class="prose prose-invert max-w-none text-gray-300 leading-relaxed">
                @((MarkupString)_article.Content)
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private NewsArticle? _article;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _article = await NewsService.GetBySlugAsync(Slug);
        _loading = false;
    }
}
