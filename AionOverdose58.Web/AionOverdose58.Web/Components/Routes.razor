<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(Client._Imports).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>404 — Aion Overdose 58</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="min-h-screen bg-aion-dark flex items-center justify-center px-4">
                <div class="text-center">
                    <div class="text-6xl mb-4">☠</div>
                    <h1 class="font-cinzel text-8xl md:text-9xl font-bold text-aion-crimson mb-4">404</h1>
                    <div class="flex items-center justify-center gap-3 mb-6">
                        <div class="h-px w-16 bg-aion-gold/40"></div>
                        <span class="text-aion-gold">⚔</span>
                        <div class="h-px w-16 bg-aion-gold/40"></div>
                    </div>
                    <p class="font-cinzel text-xl md:text-2xl text-gray-300 mb-2">The realm you seek does not exist</p>
                    <p class="font-raleway text-gray-500 mb-10 italic">Perhaps the Balaur destroyed it... or it never existed.</p>
                    <a href="/" class="inline-block bg-aion-crimson hover:bg-aion-red text-white font-cinzel uppercase tracking-widest px-8 py-3 transition-colors duration-300 rounded">
                        Return to the Eternal Sky
                    </a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
