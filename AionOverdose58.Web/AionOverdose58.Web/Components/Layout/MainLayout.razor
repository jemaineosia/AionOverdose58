@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col">
    <NavBar />
    <!-- pt-[56px] clears the fixed mobile navbar height; md:pt-0 removes it on desktop -->
    <main class="flex-1 pt-[56px] md:pt-0">
        @Body
    </main>
    <SocialBar />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="underline">Reload</a>
    <span class="dismiss cursor-pointer absolute right-3 top-2">🗙</span>
</div>
