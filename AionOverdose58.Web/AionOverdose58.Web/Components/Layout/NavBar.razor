@using Microsoft.AspNetCore.Components.Routing

<!-- ══════════════════════════════════════════
     MOBILE NAV — white bar, hamburger left, logo center
     ══════════════════════════════════════════ -->
<nav class="md:hidden fixed top-0 left-0 right-0 z-50 bg-white shadow-md">
    <div class="flex items-center justify-between px-4 py-3">
        <!-- Hamburger -->
        <button @onclick="ToggleMobileMenu" class="text-gray-800 focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>

        <!-- Logo centered
        <a href="/" class="flex items-center gap-2 absolute left-1/2 -translate-x-1/2">
            <img src="/Images/AionOD_logo.png" alt="Aion Overdose" class="h-8 w-auto" />
            <span class="font-marcellus text-gray-900 text-sm tracking-[0.25em] uppercase">U P H E A V A L</span>
        </a> -->

        <!-- Right spacer to balance hamburger -->
        <div class="w-6"></div>
    </div>

    <!-- Mobile dropdown menu -->
    @if (_showMobileMenu)
    {
        <div class="flex flex-col border-t border-gray-200 bg-white font-marcellus text-sm uppercase tracking-widest">
            <NavLink href="/" Match="NavLinkMatch.All" class="mobile-nav-link" @onclick="CloseMobileMenu">Home</NavLink>
            <NavLink href="/news" class="mobile-nav-link" @onclick="CloseMobileMenu">News</NavLink>
            <a href="#" target="_blank" rel="noopener noreferrer" class="mobile-nav-link">Wiki</a>
            <NavLink href="/ranking" class="mobile-nav-link" @onclick="CloseMobileMenu">Ranking</NavLink>
            <NavLink href="/account/login" class="mobile-nav-link" @onclick="CloseMobileMenu">Login</NavLink>
            <NavLink href="/account/register" class="mobile-nav-link" @onclick="CloseMobileMenu">Register</NavLink>
            <NavLink href="/account/panel" class="mobile-nav-link" @onclick="CloseMobileMenu">Control Panel</NavLink>
        </div>
    }
</nav>

<!-- ══════════════════════════════════════════
     DESKTOP NAV — logo top-center → site name → nav strip
     ══════════════════════════════════════════ -->
<header class="hidden md:flex absolute top-0 left-0 right-0 z-50 flex-col items-center">

    <!-- Logo image -->
    <div class="pt-6 pb-1">
        <img src="/Images/AionOD_logo.png" alt="Aion Overdose"
             class="h-28 w-auto mx-auto drop-shadow-lg" />
    </div>

    <!-- Spaced site name
    <div class="font-marcellus text-white text-xs tracking-[0.55em] uppercase mb-3"
         style="letter-spacing: 0.55em; text-shadow: 0 1px 8px rgba(0,0,0,0.8);">
        U P H E A V A L
    </div> -->

    <!-- Nav strip -->
    <nav class="w-full flex justify-center items-center py-3 px-8"
         style="background: rgba(0,0,0,0.52);">
        <div class="flex items-center font-marcellus text-xs uppercase tracking-[0.2em]">

            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link-item">HOME</NavLink>
            <span class="nav-dot">·</span>

            <NavLink href="/news" class="nav-link-item">NEWS</NavLink>
            <span class="nav-dot">·</span>

            <a href="#" target="_blank" rel="noopener noreferrer" class="nav-link-item">WIKI</a>
            <span class="nav-dot">·</span>

            <NavLink href="/ranking" class="nav-link-item">RANKING</NavLink>
            <span class="nav-dot">·</span>

            <!-- Account dropdown -->
            <div class="relative" @ref="_accountDropdownRef">
                <button @onclick="ToggleAccountMenu"
                        class="nav-link-item flex items-center gap-1 bg-transparent border-none cursor-pointer p-0">
                    ACCOUNT
                </button>

                @if (_showAccountMenu)
                {
                    <div class="dropdown-panel absolute top-full left-1/2 -translate-x-1/2 mt-2 w-52 z-50">
                        <a href="/account/login" class="dropdown-item" @onclick="CloseAccountMenu">
                            <span>Login</span><span class="dropdown-arrow">&#8250;</span>
                        </a>
                        <a href="/account/register" class="dropdown-item" @onclick="CloseAccountMenu">
                            <span>Register</span><span class="dropdown-arrow">&#8250;</span>
                        </a>
                        <a href="/account/panel" class="dropdown-item" @onclick="CloseAccountMenu">
                            <span>Control Panel</span><span class="dropdown-arrow">&#8250;</span>
                        </a>
                    </div>
                }
            </div>

        </div>
    </nav>
</header>

<style>
    /* ══════════════════════════════════════════
       Shared styles for nav links, dots, and dropdown
       ══════════════════════════════════════════ */

    /* ── Nav link ── */
    .nav-link-item {
        color: #ffffff;
        text-decoration: none;
        padding: 0 0.9rem;
        transition: color 0.2s;
        position: relative;
        white-space: nowrap;
    }
    .nav-link-item:hover {
        color: #c9a84c;
        text-decoration: line-through;
        text-decoration-color: #c9a84c;
    }
    .nav-link-item.active {
        color: #ffffff;
        text-decoration: line-through;
        text-decoration-color: rgba(255,255,255,0.8);
    }

    /* ── Dot separator ── */
    .nav-dot {
        color: rgba(255,255,255,0.35);
        font-size: 1rem;
        user-select: none;
    }

    /* ── Dropdown panel ── */
    .dropdown-panel {
        background: #1b1b1b;
    }
    .dropdown-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.8rem 1.25rem;
        color: #d4d4d4;
        font-family: 'Marcellus', serif;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        text-decoration: none;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        transition: background 0.15s, color 0.15s;
    }
    .dropdown-item:last-child { border-bottom: none; }
    .dropdown-item:hover {
        background: rgba(255,255,255,0.07);
        color: #ffffff;
    }
    .dropdown-arrow {
        color: rgba(255,255,255,0.45);
        font-size: 1.1rem;
    }
    .dropdown-item:hover .dropdown-arrow { color: #c9a84c; }

    /* ── Mobile links ── */
    .mobile-nav-link {
        display: block;
        padding: 0.85rem 1.25rem;
        color: #1f2937;
        font-family: 'Marcellus', serif;
        text-decoration: none;
        border-bottom: 1px solid #f3f4f6;
        transition: background 0.15s, color 0.15s;
    }
    .mobile-nav-link:hover,
    .mobile-nav-link.active {
        background: #f9fafb;
        color: #8b1a1a;
    }
</style>

@code {
    private bool _showAccountMenu = false;
    private bool _showMobileMenu  = false;
    private ElementReference _accountDropdownRef;

    private void ToggleAccountMenu() => _showAccountMenu = !_showAccountMenu;
    private void CloseAccountMenu()  => _showAccountMenu = false;
    private void ToggleMobileMenu()  => _showMobileMenu  = !_showMobileMenu;
    private void CloseMobileMenu()   => _showMobileMenu  = false;
}
